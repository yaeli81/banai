APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# AI agent (Phase 5). Never commit real values.
OPENAI_API_KEY=
# Configurable default when empty: gpt-5.4-mini-2026-03-17
OPENAI_CHAT_MODEL=
# Voice (chained pipeline). Configurable defaults when empty:
# gpt-4o-mini-transcribe-2025-12-15, gpt-4o-mini-tts-2025-12-15, voice alloy
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# Signs AI proposals. Required in production; a random per-process key is used locally when empty.
PROPOSAL_SIGNING_KEY=
# AGENT_MODE=fake runs a scripted agent; only allowed when APP_ENV is test or e2e.
# Filled in later phases:
OPENAI_IMAGE_MODEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
